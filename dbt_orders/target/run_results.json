\u0435\u0434\u0438\u043d\u044f\u0435\u0442 \"warehouse\".\"main\".\"stg_orders\" \u0441 \"warehouse\".\"main\".\"stg_customers\"\n--   2. \u0413\u0440\u0443\u043f\u043f\u0438\u0440\u0443\u0435\u0442 \u043f\u043e: \u043c\u0435\u0441\u044f\u0446\u0443 \u0437\u0430\u043a\u0430\u0437\u0430 (date_trunc('month', order_date))\n--      \u0438 \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0443 \u043a\u043b\u0438\u0435\u043d\u0442\u0430 (segment)\n--   3. \u0421\u0447\u0438\u0442\u0430\u0435\u0442:\n--      - total_orders    \u2014 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0437\u0430\u043a\u0430\u0437\u043e\u0432\n--      - total_revenue   \u2014 \u0441\u0443\u043c\u043c\u0430 amount\n--      - avg_order_value \u2014 \u0441\u0440\u0435\u0434\u043d\u044f\u044f \u0441\u0443\u043c\u043c\u0430 \u0437\u0430\u043a\u0430\u0437\u0430\n--      - cancelled_pct   \u2014 \u0434\u043e\u043b\u044f cancelled (0.0 \u2013 1.0)\n--   4. \u0423\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043a\u0430\u0437\u044b \u0441\u043e \u0441\u0442\u0430\u0442\u0443\u0441\u043e\u043c 'shipped' \u0434\u043b\u044f total_revenue\n--      (\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 FILTER \u0438\u043b\u0438 CASE WHEN)\n\nSELECT\n    date_trunc('month', o.order_date)::date          AS month,\n    c.segment,\n    count(*)                                         AS total_orders,\n    round(sum(\n        CASE WHEN o.status = 'shipped' THEN o.amount ELSE 0 END\n    ), 2)                                            AS total_revenue,\n    round(avg(o.amount), 2)                          AS avg_order_value,\n    round(\n        count(*) FILTER (WHERE o.status = 'cancelled')::float / count(*),\n        3\n    )                                                AS cancelled_pct\nFROM \"warehouse\".\"main\".\"stg_orders\"    AS o\nJOIN \"warehouse\".\"main\".\"stg_customers\" AS c USING (customer_id)\nGROUP BY 1, 2\nORDER BY 1, 2", "relation_name": "\"warehouse\".\"main\".\"fct_revenue\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-07T18:06:05.608946Z", "completed_at": "2026-11-07T18:06:05.620944Z"}, {"name": "execute", "started_at": "2026-11-07T18:06:05.622950Z", "completed_at": "2026-11-07T18:06:05.622950Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.016012191772460938, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dbt_orders.unique_stg_customers_customer_id.c7614daada", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    customer_id as unique_field,\n    count(*) as n_records\n\nfrom \"warehouse\".\"main\".\"stg_customers\"\nwhere customer_id is not null\ngroup by customer_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-07T18:06:05.627951Z", "completed_at": "2026-11-07T18:06:05.652843Z"}, {"name": "execute", "started_at": "2026-11-07T18:06:05.653843Z", "completed_at": "2026-11-07T18:06:05.653843Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.0289003849029541, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dbt_orders.accepted_values_stg_orders_status__pending__shipped__cancelled__returned.6983428f0b", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        status as value_field,\n        count(*) as n_records\n\n    from \"warehouse\".\"main\".\"stg_orders\"\n    group by status\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'pending','shipped','cancelled','returned'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-07T18:06:05.625950Z", "completed_at": "2026-11-07T18:06:05.652843Z"}, {"name": "execute", "starte